{
  "name": "student-tuition-payment-agent",
  "version": "1.0.0",
  "description": "FinTechathon 2026 - Cross-Border Student Tuition Payment Agent with Autonomous Tools, Permission Tiers, and Safety Guardrails",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "test:security": "npm --prefix backend run test:security",
    "seed": "npm --prefix backend run seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "fintech",
    "agentic-ai",
    "cross-border-payments",
    "tuition",
    "nestjs",
    "nextjs",
    "security-guardrails"
  ],
  "author": "FinTechathon 2026 Team",
  "license": "MIT"
}
